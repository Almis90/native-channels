<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>NativeChannels.Desktop.ProbeAssets</PackageId>
        <Description>Local-only macOS native adapter assets for desktop transport acceptance.</Description>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeSymbols>false</IncludeSymbols>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <EnablePackageValidation>false</EnablePackageValidation>
    </PropertyGroup>
    <ItemGroup>
        <None
            Include="../../artifacts/native/apple-desktop/osx-arm64/libNativeChannelsSample.dylib"
            Pack="true"
            PackagePath="runtimes/osx-arm64/native/"
        />
        <None
            Include="../../artifacts/native/apple-desktop/osx-x64/libNativeChannelsSample.dylib"
            Pack="true"
            PackagePath="runtimes/osx-x64/native/"
        />
        <None
            Include="../../artifacts/native/apple-desktop/osx-arm64/libMauiCurrencyNative.dylib"
            Pack="true"
            PackagePath="runtimes/osx-arm64/native/"
        />
        <None
            Include="../../artifacts/native/apple-desktop/osx-x64/libMauiCurrencyNative.dylib"
            Pack="true"
            PackagePath="runtimes/osx-x64/native/"
        />
    </ItemGroup>
</Project>
