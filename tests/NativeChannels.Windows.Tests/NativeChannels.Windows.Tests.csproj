<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <!-- Exercise the shipping Windows transport on every CI host, without a UI workload. -->
        <Compile
            Include="../../src/NativeChannels/NativeChannelTransport.cs"
            Link="Transport/NativeChannelTransport.cs"
        />
        <Compile
            Include="../../src/NativeChannels/NativeModuleRegistration.cs"
            Link="Transport/NativeModuleRegistration.cs"
        />
        <Compile
            Include="../../src/NativeChannels/Platforms/Windows/*.cs"
            Link="Transport/%(Filename)%(Extension)"
        />
        <ProjectReference Include="../../src/NativeChannels.Core/NativeChannels.Core.csproj" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    </ItemGroup>
</Project>
