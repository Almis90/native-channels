<Project>
    <!-- Uno 6.7 replaces platform-specific assemblies that reference Uno.UI with
       their portable counterparts on Skia mobile. Our portable assembly hosts
       desktop views, so retain NuGet's mobile selection for this package only. -->
    <Target
        Name="_NativeChannelsCaptureMobilePdfAssets"
        BeforeTargets="ReplaceUnoRuntime"
        Condition="'$(UnoUIRuntimeIdentifier)' == 'skia' And ($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android')"
    >
        <ItemGroup>
            <_NativeChannelsMobilePdfCompile
                Include="@(ResolvedCompileFileDefinitions)"
                Condition="'%(ResolvedCompileFileDefinitions.NuGetPackageId)' == 'Plugin.Uno.PdfViewer'"
            />
            <_NativeChannelsMobilePdfRuntime
                Include="@(RuntimeCopyLocalItems)"
                Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Plugin.Uno.PdfViewer'"
            />
        </ItemGroup>
    </Target>
    <Target Name="_NativeChannelsRestoreMobilePdfAssets" AfterTargets="ReplaceUnoRuntime">
        <ItemGroup Condition="'@(_NativeChannelsMobilePdfCompile)' != ''">
            <ResolvedCompileFileDefinitions
                Remove="@(ResolvedCompileFileDefinitions)"
                Condition="'%(ResolvedCompileFileDefinitions.NuGetPackageId)' == 'Plugin.Uno.PdfViewer'"
            />
            <ResolvedCompileFileDefinitions Include="@(_NativeChannelsMobilePdfCompile)" />
        </ItemGroup>
        <ItemGroup Condition="'@(_NativeChannelsMobilePdfRuntime)' != ''">
            <RuntimeCopyLocalItems
                Remove="@(RuntimeCopyLocalItems)"
                Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Plugin.Uno.PdfViewer'"
            />
            <RuntimeCopyLocalItems Include="@(_NativeChannelsMobilePdfRuntime)" />
        </ItemGroup>
    </Target>
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <AndroidLibrary
            Include="$(MSBuildThisFileDirectory)../native/android/pdf.aar"
            Bind="false"
        />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <NativeReference Include="$(MSBuildThisFileDirectory)../native/apple/MauiPdfViewerNative.xcframework">
            <Kind>Framework</Kind>
            <SmartLink>false</SmartLink>
        </NativeReference>
    </ItemGroup>
    <!-- Keep Windows projections out of Uno's global compile namespace. They are
       explicit private references so the app's deps.json records their runtime
       identities; other OS/target builds do not consume Windows SDK assemblies. -->
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('windows')) And ('$(TargetFramework)' == 'net10.0' Or '$(TargetFramework)' == 'net10.0-desktop')">
        <Reference Include="Microsoft.Windows.SDK.NET">
            <HintPath>$(MSBuildThisFileDirectory)windows/Microsoft.Windows.SDK.NET.dll</HintPath>
            <Aliases>WindowsSdk</Aliases>
            <Private>true</Private>
        </Reference>
        <Reference Include="WinRT.Runtime">
            <HintPath>$(MSBuildThisFileDirectory)windows/WinRT.Runtime.dll</HintPath>
            <Aliases>WindowsSdk</Aliases>
            <Private>true</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browser' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'browserwasm'">
        <Content
            Include="$(MSBuildThisFileDirectory)../browser/**/*"
            Link="wwwroot/_content/Plugin.Uno.PdfViewer/%(RecursiveDir)%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest"
        />
    </ItemGroup>
</Project>
