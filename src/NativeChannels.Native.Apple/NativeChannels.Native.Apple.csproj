<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Apple binding and Swift runtime bridge for NativeChannels on iOS and Mac Catalyst. Includes device, simulator, and Catalyst XCFramework slices. Installed transitively by NativeChannels on Apple targets; this is not an AppKit macOS host.</Description>
        <TargetFrameworks>net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks
            Condition="'$(NativeChannelsAppleTarget)' == 'ios' Or '$(NativeChannelsAppleTarget)' == 'maccatalyst'"
            >net10.0-$(NativeChannelsAppleTarget)</TargetFrameworks>
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
        <IsBindingProject>true</IsBindingProject>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>
    <ItemGroup>
        <ObjcBindingApiDefinition Include="ApiDefinition.cs" />
        <NativeReference Include="../../artifacts/native/NativeChannelsNative.xcframework">
            <Kind>Framework</Kind>
            <SmartLink>false</SmartLink>
        </NativeReference>
    </ItemGroup>
    <ItemGroup>
        <None Remove="$(MSBuildThisFileDirectory)../../README.md" />
        <None Include="../../docs/nuget-readme.md" Pack="true" PackagePath="/README.md" />
    </ItemGroup>
</Project>
