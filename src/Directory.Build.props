<Project>
    <Import Project="../Directory.Build.props" />
    <PropertyGroup>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>nativechannels;dotnet;maui;android;ios;maccatalyst;windows;interop</PackageTags>
        <PackageReleaseNotes>Opt-in channel diagnostics with operation timing and structured outcomes. Published API compatibility checks, native profiling tools and updated package presentation. Full notes: https://almis90.github.io/native-channels/changelog</PackageReleaseNotes>
    </PropertyGroup>
    <ItemGroup>
        <None
            Include="$(MSBuildThisFileDirectory)../assets/package-icon.png"
            Pack="true"
            PackagePath="/icon.png"
        />
    </ItemGroup>
</Project>
