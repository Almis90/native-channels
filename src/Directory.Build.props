<Project>
    <Import Project="../Directory.Build.props" />
    <PropertyGroup>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>nativechannels;dotnet;maui;android;ios;maccatalyst;windows;interop</PackageTags>
        <PackageReleaseNotes>0.2 development preview: shared hosting, Avalonia native and DOM views, and five samples across six targets. Platform verification and release acceptance remain in progress. Full notes: https://almis90.github.io/native-channels/changelog</PackageReleaseNotes>
    </PropertyGroup>
    <ItemGroup>
        <None
            Include="$(MSBuildThisFileDirectory)../assets/package-icon.png"
            Pack="true"
            PackagePath="/icon.png"
        />
    </ItemGroup>
</Project>
