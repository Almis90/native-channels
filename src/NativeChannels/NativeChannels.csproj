<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>NativeChannels platform transports and explicit native module registration for Android, iOS, Mac Catalyst, and Windows. Connect .NET channels to Kotlin, Swift, and Windows adapters.</Description>
        <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))"
            >$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
        <TargetFrameworks Condition="'$(NativeChannelsAndroidOnly)' == 'true'"
            >net10.0-android</TargetFrameworks>
        <TargetFrameworks
            Condition="'$(NativeChannelsAppleTarget)' == 'ios' Or '$(NativeChannelsAppleTarget)' == 'maccatalyst' Or '$(NativeChannelsAppleTarget)' == 'macos'"
            >net10.0-$(NativeChannelsAppleTarget)</TargetFrameworks>
        <TargetFrameworks Condition="'$(NativeChannelsWindowsOnly)' == 'true'"
            >net10.0-windows10.0.19041.0</TargetFrameworks>
        <TargetFrameworks Condition="'$(NativeChannelsLinuxOnly)' == 'true'"
            >net10.0</TargetFrameworks>
        <DefineConstants Condition="'$(NativeChannelsLinuxOnly)' == 'true'"
            >$(DefineConstants);LINUX</DefineConstants>
        <TargetFrameworks Condition="'$(NativeChannelsBrowserOnly)' == 'true'"
            >net10.0-browser</TargetFrameworks>
        <AllowUnsafeBlocks Condition="'$(NativeChannelsBrowserOnly)' == 'true'"
            >true</AllowUnsafeBlocks>
        <SupportedOSPlatformVersion
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'"
            >24</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'"
            >15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'"
            >14.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'"
            >10.0.17763.0</SupportedOSPlatformVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <ProjectReference
            Include="../NativeChannels.Core/NativeChannels.Core.csproj"
            Condition="'$(NativeChannelsUseCorePackage)' != 'true'"
        />
        <PackageReference
            Include="NativeChannels.Core"
            Condition="'$(NativeChannelsUseCorePackage)' == 'true'"
        />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <ProjectReference Include="../NativeChannels.Native.Android/NativeChannels.Native.Android.csproj" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
        <ProjectReference Include="../NativeChannels.Native.Apple/NativeChannels.Native.Apple.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None
            Include="Platforms/Browser/*.mjs"
            Pack="true"
            PackagePath="browser/"
            Condition="'$(NativeChannelsBrowserOnly)' == 'true'"
        />
        <None
            Include="buildTransitive/NativeChannels.targets"
            Pack="true"
            PackagePath="buildTransitive/"
        />
        <None Remove="$(MSBuildThisFileDirectory)../../README.md" />
        <None Include="../../docs/nuget-readme.md" Pack="true" PackagePath="/README.md" />
    </ItemGroup>
</Project>
