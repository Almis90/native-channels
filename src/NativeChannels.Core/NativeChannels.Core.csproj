<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsTrimmable>true</IsTrimmable>
    </PropertyGroup>
    <Target
        Name="RejectSharedCoreRebuild"
        BeforeTargets="PrepareForBuild"
        Condition="'$(NativeChannelsUseCorePackage)' == 'true'"
    >
        <Error Text="Platform CI must consume the shared Core package, not rebuild Core from source." />
    </Target>
    <ItemGroup>
        <None Remove="$(MSBuildThisFileDirectory)../../README.md" />
        <None Include="../../docs/nuget-readme.md" Pack="true" PackagePath="/README.md" />
    </ItemGroup>
</Project>
