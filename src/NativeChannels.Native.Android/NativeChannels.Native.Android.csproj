<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Android binding and Kotlin runtime bridge for NativeChannels. Includes the generic messaging AAR and native view bridge. Installed transitively by NativeChannels on Android; application-specific native adapters are registered separately.</Description>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
        <IsBindingProject>true</IsBindingProject>
        <RootNamespace>NativeChannels.Native.Android</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <AndroidLibrary Include="../../native/android/library/build/outputs/aar/library-release.aar" />
        <PackageReference Include="Xamarin.Kotlin.StdLib" />
    </ItemGroup>
    <ItemGroup>
        <None Remove="$(MSBuildThisFileDirectory)../../README.md" />
        <None Include="../../docs/nuget-readme.md" Pack="true" PackagePath="/README.md" />
    </ItemGroup>
</Project>
