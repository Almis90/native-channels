<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <NativeChannelsPackageVersion Condition="'$(NativeChannelsPackageVersion)' == ''"
            >0.2.0-preview.1</NativeChannelsPackageVersion>
        <CurrencyPackageVersion Condition="'$(CurrencyPackageVersion)' == ''"
            >1.1.0-alpha.1</CurrencyPackageVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Avalonia" Version="12.1.4" />
        <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.4" />
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
        <PackageVersion
            Include="NativeChannels.Avalonia"
            Version="$(NativeChannelsPackageVersion)"
        />
        <PackageVersion Include="Avalonia.Android" Version="12.1.4" />
        <PackageVersion Include="Avalonia.iOS" Version="12.1.4" />
        <PackageVersion Include="Plugin.Avalonia.PdfViewer" Version="0.1.0-alpha.1" />
        <PackageVersion Include="System.Drawing.Common" Version="10.0.0" />
        <PackageVersion Include="Avalonia.Browser" Version="12.1.4" />
        <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageVersion Include="NativeChannels.Core" Version="$(NativeChannelsPackageVersion)" />
        <PackageVersion Include="NativeChannels" Version="$(NativeChannelsPackageVersion)" />
        <PackageVersion
            Include="Microsoft.Extensions.DependencyInjection.Abstractions"
            Version="10.0.0"
        />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
        <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />
        <PackageVersion Include="Xamarin.Kotlin.StdLib" Version="2.3.0.1" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageVersion
            Include="NativeChannels.Native.Android"
            Version="$(NativeChannelsPackageVersion)"
        />
        <PackageVersion
            Include="NativeChannels.Native.Apple"
            Version="$(NativeChannelsPackageVersion)"
        />
        <PackageVersion Include="Plugin.AudioStreamer" Version="0.1.0-alpha.1" />
        <PackageVersion Include="Plugin.Maui.PdfViewer" Version="0.1.0-alpha.1" />
        <PackageVersion Include="Plugin.VolumeMonitor" Version="0.1.0-alpha.1" />
        <PackageVersion Include="Plugin.Currency" Version="$(CurrencyPackageVersion)" />
        <PackageVersion Include="NativeChannels.Maui" Version="$(NativeChannelsPackageVersion)" />
    </ItemGroup>
</Project>
