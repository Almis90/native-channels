<Project Sdk="Uno.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <RootNamespace>UnoSamples</RootNamespace>
        <UnoSingleProject>true</UnoSingleProject>
        <UnoFeatures>SkiaRenderer</UnoFeatures>
        <ApplicationTitle>NativeChannels PdfViewer</ApplicationTitle>
        <ApplicationId>dev.nativechannels.uno.pdfviewer</ApplicationId>
        <ApplicationDisplayVersion>0.3.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationPublisher>NativeChannels</ApplicationPublisher>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="NativeChannels" />
        <PackageReference Include="NativeChannels.Uno" />
        <PackageReference Include="Plugin.Uno.PdfViewer" />
        <Compile Include="../Shared/App.cs" Link="App.xaml.cs" />
        <Compile Include="../Shared/SamplePage.cs" Link="SamplePage.cs" />
        <Compile Include="../Shared/PdfProtocolProbe.cs" Link="PdfProtocolProbe.cs" />
        <Content
            Include="../../Maui/PdfViewer/Resources/Raw/nativechannels-guide.pdf"
            Link="nativechannels-guide.pdf"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-desktop'">
        <DefineConstants>$(DefineConstants);SAMPLE_DESKTOP</DefineConstants>
    </PropertyGroup>
    <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-desktop'">
        <Compile Remove="NativePdfProbe.cs" />
    </ItemGroup>
</Project>
