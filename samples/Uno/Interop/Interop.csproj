<Project Sdk="Uno.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <RootNamespace>UnoSamples</RootNamespace>
        <DefineConstants>$(DefineConstants);UNO_SAMPLE</DefineConstants>
        <UnoSingleProject>true</UnoSingleProject>
        <UnoFeatures>SkiaRenderer</UnoFeatures>
        <ApplicationTitle>NativeChannels Interop</ApplicationTitle>
        <ApplicationId>dev.nativechannels.uno.interop</ApplicationId>
        <ApplicationDisplayVersion>0.3.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationPublisher>NativeChannels</ApplicationPublisher>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="NativeChannels" />
        <PackageReference Include="NativeChannels.Uno" />

        <Compile Include="../Shared/App.cs" Link="App.xaml.cs" />
        <Compile Include="../Shared/SamplePage.cs" Link="SamplePage.cs" />
        <Compile Include="../Feasibility/UnoFeasibility/HostProbe.cs" Link="HostProbe.cs" />
        <Compile Include="../Feasibility/UnoFeasibility/Win32Probe.cs" Link="Win32Probe.cs" />
    </ItemGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-desktop'">
        <DefineConstants>$(DefineConstants);SAMPLE_DESKTOP;UNO_SAMPLE</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android')">
        <AssemblyName>NativeChannels.Interop.Uno</AssemblyName>
    </PropertyGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-desktop' Or '$(TargetFramework)' == 'net10.0-browserwasm' Or ($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android')">
        <Compile Include="../../Maui/ChannelExplorer/GlobalUsings.cs" Link="ChannelUsings.cs" />
        <Compile
            Include="../../Maui/ChannelExplorer/NativeVerification.cs"
            Link="NativeVerification.cs"
        />
        <Compile Include="../../Maui/ChannelExplorer/SampleModels.cs" Link="SampleModels.cs" />
        <Compile
            Include="../../Maui/ChannelExplorer/SampleJsonContext.cs"
            Link="SampleJsonContext.cs"
        />
        <Compile
            Include="../../Avalonia/Interop/Shared/ViewVerification.cs"
            Link="ViewVerification.cs"
        />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-desktop'">
        <Compile
            Include="../../../native/windows/sample/WindowsSampleModule.cs"
            Link="WindowsSampleModule.cs"
        />
        <Compile
            Include="../../Avalonia/Interop/Shared/WindowsButtonView.cs"
            Link="WindowsButtonView.cs"
        />
    </ItemGroup>
    <ItemGroup Condition="($([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android')">
        <Compile
            Include="../../Avalonia/Interop/Shared/SampleButtonFactory.cs"
            Link="MobileButtonView.cs"
        />
        <NativeReference
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'"
            Include="../../../artifacts/native/NativeChannelsSample.xcframework"
        >
            <Kind>Framework</Kind>
            <SmartLink>false</SmartLink>
        </NativeReference>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-desktop'">
        <Compile Remove="NativeButtons.cs" />
        <Compile
            Remove="SamplePlatform.cs"
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android' And '$(TargetFramework)' != 'net10.0-browserwasm'"
        />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <AndroidLibrary
            Include="../../../native/android/sample/build/outputs/aar/sample-release.aar"
            Bind="false"
        />
    </ItemGroup>
    <PropertyGroup Condition="'$(NativeChannelsLinuxOnly)' == 'true'">
        <DefineConstants>$(DefineConstants);UNO_LINUX_SAMPLE</DefineConstants>
        <AssemblyName>NativeChannels.Interop.Uno</AssemblyName>
    </PropertyGroup>
    <ItemGroup Condition="'$(NativeChannelsLinuxOnly)' == 'true'">
        <Compile
            Include="../../../src/Shared.NativeViews/UnoLinuxNativeView.cs"
            Link="UnoLinuxNativeView.cs"
        />
        <None
            Include="../../../artifacts/native/linux-x64/libnc_sample.so"
            Link="libnc_sample.so"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>
    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
        <DefineConstants>$(DefineConstants);UNO_SAMPLE</DefineConstants>
        <AssemblyName>NativeChannels.Interop.Uno</AssemblyName>
    </PropertyGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
        <Content
            Include="../../Avalonia/Interop/Browser/wwwroot/*.mjs"
            Link="wwwroot/%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
        />
        <Content
            Include="browser-button.mjs"
            Link="wwwroot/browser-button.mjs"
            CopyToOutputDirectory="PreserveNewest"
        />
    </ItemGroup>
</Project>
