<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-ios</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>disable</ImplicitUsings>
        <ApplicationId>dev.nativechannels.currency.avalonia</ApplicationId>
        <ApplicationTitle>Currency Symbols — Avalonia</ApplicationTitle>
        <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.iOS" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Plugin.Maui.Currency" />
        <Compile Include="../Currency.Shared/PluginVerification.cs" Link="PluginVerification.cs" />
        <Compile Include="../Currency.Avalonia.Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
