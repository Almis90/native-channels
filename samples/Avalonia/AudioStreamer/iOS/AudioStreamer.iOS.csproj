<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-ios</TargetFramework>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
        <ApplicationId>dev.nativechannels.audiostreamer.avalonia.ios</ApplicationId>
        <ApplicationTitle>AudioStreamer</ApplicationTitle>
        <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.iOS" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="NativeChannels.Avalonia" />
        <PackageReference Include="Plugin.AudioStreamer" />
        <Compile Include="../../Shared/SampleApplication.cs" Link="SampleApplication.cs" />
        <Compile Include="../CrossPlatform/*.cs" Link="%(Filename)%(Extension)" />
        <Compile Include="../../../Maui/AudioStreamer/MusicGenerator.cs" Link="MusicGenerator.cs" />
    </ItemGroup>
    <ItemGroup>
        <Compile
            Include="../../../Maui/AudioStreamer/AudioVerification.cs"
            Link="AudioVerification.cs"
        />
    </ItemGroup>
</Project>
