<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
    <PropertyGroup>
        <TargetFramework>net10.0-browser</TargetFramework>
        <IsPackable>false</IsPackable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Browser" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="NativeChannels.Avalonia" />
        <PackageReference Include="Plugin.AudioStreamer" />
        <Compile Include="../../Shared/SampleApplication.cs" Link="SampleApplication.cs" />
        <Compile Include="../CrossPlatform/*.cs" Link="%(Filename)%(Extension)" />
        <Compile Include="../../../Maui/AudioStreamer/MusicGenerator.cs" Link="MusicGenerator.cs" />
    </ItemGroup>
    <ItemGroup>
        <Compile
            Include="../../../Maui/AudioStreamer/AudioVerification.cs"
            Link="AudioVerification.cs"
        />
    </ItemGroup>
</Project>
