<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-ios</TargetFramework>
        <TargetFramework Condition="'$(CurrencyAppleTarget)' == 'maccatalyst'"
            >net10.0-maccatalyst</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationId>dev.nativechannels.currency.avalonia</ApplicationId>
        <ApplicationId Condition="'$(CurrencyAppleTarget)' == 'maccatalyst'"
            >dev.nativechannels.currency.avalonia.catalyst</ApplicationId>
        <ApplicationTitle>Currency Symbols — Avalonia</ApplicationTitle>
        <ApplicationTitle Condition="'$(CurrencyAppleTarget)' == 'maccatalyst'"
            >Currency Symbols — Avalonia Catalyst</ApplicationTitle>
        <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.iOS" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Plugin.Currency" />
        <Compile
            Include="../../../Currency.Shared/PluginVerification.cs"
            Link="PluginVerification.cs"
        />
        <ProjectReference Include="../Currency/Currency.csproj" />
    </ItemGroup>
</Project>
