<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-ios</TargetFramework>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
        <ApplicationId>dev.nativechannels.volumemonitor.avalonia.ios</ApplicationId>
        <ApplicationTitle>VolumeMonitor</ApplicationTitle>
        <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.iOS" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="NativeChannels.Avalonia" />
        <PackageReference Include="Plugin.VolumeMonitor" />
        <Compile Include="../../Shared/SampleApplication.cs" Link="SampleApplication.cs" />
        <Compile Include="../Shared/*.cs" Link="%(Filename)%(Extension)" />
    </ItemGroup>
    <ItemGroup>
        <Compile
            Include="../../../Maui/VolumeMonitor/VolumeVerification.cs"
            Link="VolumeVerification.cs"
        />
    </ItemGroup>
    <ItemGroup>
        <Compile
            Include="../../../Maui/VolumeMonitor/AudioSessionScope.cs"
            Link="AudioSessionScope.cs"
        />
    </ItemGroup>
</Project>
