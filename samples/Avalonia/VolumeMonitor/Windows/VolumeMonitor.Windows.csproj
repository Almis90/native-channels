<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="NativeChannels.Avalonia" />
        <PackageReference Include="Plugin.VolumeMonitor" />
        <Compile Include="../../Shared/SampleApplication.cs" Link="SampleApplication.cs" />
        <Compile Include="../Shared/*.cs" Link="%(Filename)%(Extension)" />
    </ItemGroup>
    <ItemGroup>
        <Compile
            Include="../../../Maui/VolumeMonitor/VolumeVerification.cs"
            Link="VolumeVerification.cs"
        />
    </ItemGroup>
    <ItemGroup>
        <Compile
            Include="../../../Maui/VolumeMonitor/AudioSessionScope.cs"
            Link="AudioSessionScope.cs"
        />
    </ItemGroup>
</Project>
