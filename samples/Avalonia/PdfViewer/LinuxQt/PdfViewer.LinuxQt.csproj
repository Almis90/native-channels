<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="NativeChannels.Avalonia" />
        <PackageReference Include="Plugin.Avalonia.PdfViewer" />
        <Compile Include="../../Shared/SampleApplication.cs" Link="SampleApplication.cs" />
        <Compile Include="../Shared/*.cs" Link="%(Filename)%(Extension)" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource
            Include="../../../Maui/PdfViewer/Resources/Raw/nativechannels-guide.pdf"
            LogicalName="Verification.pdf"
        />
    </ItemGroup>
</Project>
