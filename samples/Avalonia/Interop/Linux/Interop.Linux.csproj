<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <AssemblyName>NativeChannels.Interop.Avalonia</AssemblyName>
        <DefineConstants>$(DefineConstants);AVALONIA</DefineConstants>
        <OutputType>Exe</OutputType>
        <DefineConstants>$(DefineConstants);AVALONIA;LINUX</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <PackageReference Include="NativeChannels.Avalonia" />
        <PackageReference Include="NativeChannels" />
        <Compile Include="../../Shared/SampleApplication.cs" Link="SampleApplication.cs" />
        <Compile Include="../Shared/*.cs" Link="%(Filename)%(Extension)" />
    </ItemGroup>
    <Import Project="../Interop.targets" />
</Project>
